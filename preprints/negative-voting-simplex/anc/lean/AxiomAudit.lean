run_cmd do
  let env ← getEnv
  let _ ← env.constants.foldM (init := ()) fun _ name info => do
    let own := match env.getModuleIdxFor? name with
      | some idx => firstPartyModule env.header.moduleNames[idx.toNat]!
      | none => false
    if own then
      if info.isAxiom then throwError "Custom axiom in project module: {name}"
      if info.isTheorem then
        let axioms ← collectAxioms name
        for a in axioms do
          unless #[`propext, `Classical.choice, `Quot.sound].contains a do
            throwError "Disallowed axiom {a} in {name}"
        let record := Json.mkObj [
          ("constant", toJson name.toString),
          ("axioms", toJson (axioms.toList.map Name.toString))]
        logInfo m!"NV_AXIOM_JSON {record.compress}"
    pure ()
  pure ()
